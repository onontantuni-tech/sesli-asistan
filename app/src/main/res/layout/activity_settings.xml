<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ayarlar"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Gemini API anahtarı"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ücretsiz almak için aşağıdaki düğmeye bas, Google hesabınla gir, “Create API key” de ve çıkan anahtarı kopyalayıp buraya yapıştır."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/apiKey"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/input_bg"
            android:hint="AIza…"
            android:inputType="textNoSuggestions"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <Button
            android:id="@+id/btnGetKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ücretsiz anahtar al (aistudio.google.com)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Model adı"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/model"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_bg"
            android:inputType="textNoSuggestions"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Asistanın adı"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/assistantName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_bg"
            android:inputType="textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/wakeWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Arka planda adımı dinle (“Harun” deyince açılayım)"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telefon kilitliyken ya da başka uygulamadayken de çalışması için bir sonraki düğmeyle ‘Diğer uygulamaların üzerinde göster’ iznini aç. Bu mod biraz daha fazla pil kullanır."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Arka planda açılma iznini ver" />

        <CheckBox
            android:id="@+id/autoListen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Uygulama açılınca hemen dinlemeye başla"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/speak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cevapları sesli oku"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/confirmSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMS göndermeden önce onay iste"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/btnAssistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Varsayılan asistan ayarlarını aç" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bazı telefonlarda ana tuşa uzun basınca veya kulaklık tuşuna basınca bu asistanın açılmasını buradan seçebilirsin."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Kaydet" />
    </LinearLayout>
</ScrollView>
